# Comma-separated deployment values. Leave TURN_URLS empty until a real TURN service is deployed.
STUN_URLS=
TURN_URLS=

# Set TURN_SHARED_SECRET with Firebase Secret Manager, never in an env file or client bundle:
# firebase functions:secrets:set TURN_SHARED_SECRET
# Configure the TURN server's use-auth-secret/static-auth-secret to the same secret.
