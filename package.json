{
  "name": "the-controller",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:dev": "node scripts/desktop-dev.cjs",
    "desktop:pack": "npm run build && electron-builder --win nsis",
    "android:pack": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "firebase:deploy": "npx firebase-tools deploy --project the-controller-982de --only firestore:rules,firestore:indexes,functions",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21",
    "electron": "^44.5.1",
    "electron-builder": "^26.16.1"
  },
  "build": {
    "appId": "com.thecontroller.desktop",
    "productName": "THE CONTROLLER",
    "files": ["dist/**", "electron/**", "package.json"],
    "extraResources": [
      { "from": "agent-daemon/agent-runtime.cjs", "to": "agent-daemon/agent-runtime.cjs" },
      { "from": "electron/windows-input.ps1", "to": "windows-input.ps1" }
    ],
    "win": { "target": ["nsis"], "artifactName": "THE-CONTROLLER-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true }
  }
}
